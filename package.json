{
  "name": "envi-learn",
  "version": "0.4.1",
  "description": "EnVi Learn — personal English-Vietnamese vocabulary app for macOS",
  "author": "Hieu Tran",
  "main": "./out/main/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/ds.css"
  },
  "private": true,
  "scripts": {
    "predev": "npm run sync:pdfjs && npm run build:helper",
    "dev": "electron-vite dev",
    "prebuild": "npm run sync:pdfjs && npm run build:helper",
    "build": "electron-vite build",
    "release:mac": "npm run build && electron-builder --mac --publish never",
    "release:publish": "npm run release:mac && node scripts/publish-release.mjs",
    "release:dir": "npm run build && electron-builder --dir",
    "sync:pdfjs": "node scripts/sync-pdfjs.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "preview": "electron-vite preview",
    "build:ds": "tsup && cp dist/index.d.mts dist/index.d.ts && npm run build:ds:css",
    "build:ds:css": "tailwindcss -i ./src/renderer/src/styles/globals.css -o ./dist/ds.css",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node scripts/test-in-electron.mjs run",
    "db:generate": "drizzle-kit generate",
    "check:no-raw-sql": "! grep -rn --include='*.ts' -E '\\.prepare\\(' src/renderer/src | grep -v test",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && npm run sync:pdfjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "marked": "^18.0.14",
    "three": "^0.186.1",
    "ws": "^8.21.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^6.1.200",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grab": "^0.1.37",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "ts-fsrs": "5.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.10"
  }
}
